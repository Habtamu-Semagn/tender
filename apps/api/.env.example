# =============================================================================
# Chereta backend — copy to .env and edit. NEVER commit the real .env.
#   cp .env.example .env
# =============================================================================

# --- Core -------------------------------------------------------------------
NODE_ENV=development
# API listen port (container always runs on 4001 internally).
PORT=4001
API_BASE_URL=http://localhost:4001
WEB_BASE_URL=http://3002
# Comma-separated allowlist. No wildcards in production.
CORS_ORIGINS=http://localhost:3002

# --- Database ---------------------------------------------------------------
# Host port 5541 because 5432/5433 are taken by other stacks on this machine.
# Inside Docker Compose the hostname is `postgres` and the port is 5432.
DATABASE_URL=postgresql://chereta:chereta_dev_password@localhost:5541/chereta?schema=public
# Only needed by `prisma migrate dev` (shadow database). Must be a DIFFERENT
# database from DATABASE_URL.
SHADOW_DATABASE_URL=postgresql://chereta:chereta_dev_password@localhost:5541/chereta_shadow?schema=public

# --- Auth secrets -----------------------------------------------------------
# Generate real values with: openssl rand -base64 48
# Minimum 32 characters. MUST differ between development, test and production.
JWT_ACCESS_SECRET=dev_only_replace_me_with_at_least_32_random_chars
JWT_REFRESH_SECRET=dev_only_replace_me_with_at_least_32_random_chars
# Access token lifetime.
JWT_ACCESS_TTL=15m
# Refresh token lifetime.
JWT_REFRESH_TTL=7d
# Cookie signing key for the CSRF double-submit token.
CSRF_SECRET=dev_only_replace_me_with_at_least_32_random_chars
# Set to true when serving the SPA from a different origin over HTTPS.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
# Stricter limits on auth endpoints.
AUTH_RATE_LIMIT_TTL=900
AUTH_RATE_LIMIT_MAX=10

# --- Object storage ---------------------------------------------------------
# driver: "s3" (production) | "local" (dev/tests)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=.storage
# Public URL of the API when generating presigned links (S3 driver).
STORAGE_PUBLIC_BASE_URL=http://localhost:4001
# S3-compatible settings (STORAGE_DRIVER=s3 only). Buckets MUST be private.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=chereta-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- Email ------------------------------------------------------------------
# driver: "log" (dev) | "smtp" (production)
EMAIL_DRIVER=log
EMAIL_FROM="Chereta <no-reply@chereta.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- Background jobs --------------------------------------------------------
JOB_POLL_INTERVAL_MS=5000
JOB_MAX_ATTEMPTS=5
JOB_BATCH_SIZE=10

# --- Platform policy (configurable; verify legally before production) -------
DEFAULT_CURRENCY=ETB
DEFAULT_TIMEZONE=Africa/Addis_Ababa
DEFAULT_COUNTRY_CODE=ET
# Require an admin-verified organization before a member may publish a tender.
REQUIRE_VERIFIED_ORG_TO_PUBLISH=true
# Require an admin-verified organization before a member may submit a bid.
REQUIRE_VERIFIED_ORG_TO_BID=true
# Require two authorized organization members to confirm a confidential bid opening.
BID_OPENING_REQUIRES_TWO_AUTHORIZED=true

# --- Observability ----------------------------------------------------------
LOG_LEVEL=debug
# health/metrics verbosity
ENABLE_REQUEST_LOGGING=true
